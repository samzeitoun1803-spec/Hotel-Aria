# ─────────────────────────────────────────────────────────────
# Envoi des demandes de voyage (formulaire + module « Votre prochain voyage »)
# Copiez ce fichier en `.env` et choisissez UN transport.
#
#   formsubmit → e-mail direct à l'agence via https://formsubmit.co, sans compte (DÉFAUT en production)
#                la 1re demande déclenche un e-mail d'activation à l'adresse de l'agence : cliquer « Activate Form »
#   demo      → aucune donnée envoyée, simule un succès (défaut en développement)
#   mailto    → ouvre la messagerie du visiteur, pré-remplie vers l'adresse de l'agence
#   formspree → https://formspree.io  (VITE_FORMSPREE_ID requis)
#   api       → votre propre endpoint, reçoit un POST JSON (VITE_TRIP_API_URL requis)
#   supabase  → insertion REST dans une table (VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, VITE_SUPABASE_TABLE)
# ─────────────────────────────────────────────────────────────
VITE_TRIP_TRANSPORT=

# Adresse qui reçoit les demandes (FormSubmit). Par défaut : l'e-mail de l'agence (src/content/agency.ts).
VITE_FORMSUBMIT_EMAIL=

VITE_FORMSPREE_ID=
VITE_TRIP_API_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_TABLE=trip_requests
