# URL publique du site (canonical, sitemap, Open Graph, JSON-LD).
# Exemple : https://www.votre-domaine.fr — à renseigner avant la mise en ligne.
NEXT_PUBLIC_SITE_URL=

# ── Formulaire de contact ─────────────────────────────────────────────
# Le formulaire choisit automatiquement le premier transport configuré :
#   1. Resend (e-mail)   → RESEND_API_KEY + CONTACT_TO_EMAIL + CONTACT_FROM_EMAIL
#   2. Webhook (n8n, Make, Zapier, Slack…) → CONTACT_WEBHOOK_URL
#   3. Mode démonstration → CONTACT_DRY_RUN=true (journalise la demande, renvoie un succès)
# Sans transport en production, l'API renvoie une erreur explicite (aucune demande perdue en silence).

RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

CONTACT_WEBHOOK_URL=

CONTACT_DRY_RUN=false
